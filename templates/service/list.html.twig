<table>
	<thead>
		<th>Service name
		</th>
		<th></th>
		<th>
			Actions
		</th>
	</thead>
	{% for service in services %}
		<tr>
			<td>{{ service.name }}</td>
		</tr>
		<tr>
			<td>Show</td>
			<td>
				<a href="{{ path('edit_service', {'id': service.original.id|default(service.id) })}}">Edit</td>
			</td>
			<td>
				<a href="{{ path('delete_service', {'id': service.original.id|default(service.id) })}}">
					Delete</td>
			</td>
		</tr>
	{% endfor %}
</table>
